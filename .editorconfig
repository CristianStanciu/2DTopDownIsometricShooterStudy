# EditorConfig — Unity C# conventions for 2D Top-Down Isometric Shooter Study (P0.E5.T1)
#
# Rules mirror the code AS SURVEYED on 2026-10-06 across all 48 scripts in
# Assets/Scripts (numbers in comments are the survey evidence):
#   explicit types (0 `var` usages), no `this.` qualification (0 usages),
#   Allman braces (349 standalone `{` lines vs 2 inline), 4-space indent,
#   private fields camelCase (82 plain vs 28 `_`-prefixed outliers),
#   `[SerializeField] private` for inspector-exposed fields (42 usages).
# CI formatter enforcement is deferred with P0.E5.T2 (analyzers + warnings-as-errors
# in ci.yml) until the first green Actions run is available.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{yml,yaml}]
indent_size = 2

[*.md]
# markdown hard line breaks rely on trailing double-spaces
trim_trailing_whitespace = false

[*.cs]
# Worktree reality on this project: CRLF checkout (git autocrlf), 4-space indent,
# UTF-8 **with BOM** in all 48 scripts (survey 2026-10-06 — don't let editors strip it).
end_of_line = crlf
indent_size = 4
charset = utf-8-bom

# --- import ordering -----------------------------------------------------------
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# --- explicit types policy: never use `var` (survey: 0 usages) -----------------
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion

# --- no `this.` qualification (survey: 0 usages) -------------------------------
csharp_style_qualification_for_field = false:suggestion
csharp_style_qualification_for_property = false:suggestion
csharp_style_qualification_for_method = false:suggestion
csharp_style_qualification_for_event = false:suggestion

# --- braces: Allman everywhere, always required --------------------------------
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_prefer_braces = true:suggestion

# --- keywords over BCL type names ----------------------------------------------
csharp_style_preferred_keyword_type_name = true:suggestion

# --- file headers with roadmap ID refs (P0.E5.T1) ------------------------------
# Activating this backfills every existing file — enable together with the E5.T2
# analyzer baseline and a dedicated churn PR, uncomment then:
#file_header_template = Copyright (c) Tadadosi — see LICENSE.\n// SPDX task/defect ref: P0.EX.TY <short description>

# --- legacy suppression kept from the original 4-line file ---------------------
# IDE0052: Remove unread private members (Unity serializes fields the compiler
# never sees read; catalogue + reasons: docs/qa/warning-policy.md)
dotnet_diagnostic.IDE0052.severity = none

# --- naming (soft suggestions; enforcement arrives with E5.T2 analyzers) -------
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.private_fields_camel.required_prefix =
dotnet_naming_style.private_fields_camel.capitalization = camel_case
dotnet_naming_rule.private_fields_camel.severity = suggestion
dotnet_naming_rule.private_fields_camel.symbols = private_fields
dotnet_naming_rule.private_fields_camel.style = private_fields_camel

dotnet_naming_symbols.types_and_members.applicable_kinds = class,struct,interface,enum,property,event,method
dotnet_naming_symbols.types_and_members.applicable_accessibilities = public, internal
dotnet_naming_style.pascal_case.required_prefix =
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_rule.types_and_members_pascal.severity = suggestion
dotnet_naming_rule.types_and_members_pascal.symbols = types_and_members
dotnet_naming_rule.types_and_members_pascal.style = pascal_case
